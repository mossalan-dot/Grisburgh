{
  "name": "grisburgh",
  "version": "1.0.0",
  "description": "Grisburgh D&D Campaign Manager",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "DEV_AUTO_DM=1 node --watch server.js",
    "pretest": "[ -d node_modules ] || npm install",
    "test": "node --test --test-concurrency=1 'tests/*.test.js'",
    "test:watch": "node --test --watch --test-concurrency=1 'tests/*.test.js'",
    "tunnel": "cloudflared tunnel --url http://localhost:3000"
  },
  "dependencies": {
    "compression": "^1.8.1",
    "express": "^4.21.0",
    "express-session": "^1.18.0",
    "multer": "^1.4.5-lts.1",
    "session-file-store": "^1.5.0",
    "sharp": "^0.34.5",
    "socket.io": "^4.7.0"
  },
  "devDependencies": {
    "socket.io-client": "^4.8.3"
  }
}
