+
+/* ── Tegels: bladeren met pijltjes (10 nov 2026) ─────────────────────────────
+   Zoals de bladerkaart in het Heldenboek: ‹ en › om de blad-icoontjes heen,
+   in dezelfde vorm als .vk-pijl. Aan het eind van de rij staat de pijl uit. */
+.tegel-pijl {
+  width: 26px; height: 26px; flex: 0 0 auto;
+  display: flex; align-items: center; justify-content: center;
+  border: 1px solid rgba(196,168,122,.7); border-radius: 5px;
+  background: rgba(255,250,238,.6); color: #5a4030; cursor: pointer;
+}
+.tegel-pijl .icon { width: 14px; height: 14px; }
+.tegel-pijl:hover:not(:disabled) { background: rgba(196,168,122,.25); color: #2a1a08; }
+.tegel-pijl:disabled { opacity: .3; cursor: default; }
+.tegel-punten { align-items: center; }
+/* Het blad schuift; wat er buiten de tegel valt, hoort niet te zien te zijn. */
+.tegel--open { overflow: hidden; }
+/* Op het portretblad zou een crèmekleurige voet de foto afsnijden; het
+   Heldenboek laat zijn balkje daar doorzichtig over de plaat lopen. Hier
+   hetzelfde: de donkere voet van de naamband draagt de knoppen, en die worden
+   licht. Een tegel zonder beeld houdt zijn lichte voet. */
+.tegel--open:not(.no-img):has(.tegel-blad[data-soort="portret"]) .tegel-voet {
+  background: none; border-top-color: transparent;
+}
+.tegel--open:not(.no-img):has(.tegel-blad[data-soort="portret"]) :is(.tegel-punt, .tegel-knop, .tegel-voet .tegel-dm button, .tegel-voet .tegel-ster) {
+  color: rgba(255,248,234,.85);
+}
+.tegel--open:not(.no-img):has(.tegel-blad[data-soort="portret"]) .tegel-knop { border-color: rgba(255,248,234,.35); }
+.tegel--open:not(.no-img):has(.tegel-blad[data-soort="portret"]) .tegel-punt.is-aan { background: rgba(255,248,234,.9); color: #2a1a08; }
+.tegel--open:not(.no-img):has(.tegel-blad[data-soort="portret"]) .tegel-pijl {
+  border-color: rgba(255,248,234,.45); background: rgba(20,12,4,.4); color: #f3e7cf;
+}
+/* De naam staat dan boven de knoppen in plaats van erachter. */
+.tegel--open:not(.no-img) .tegel-naamband--groot { padding-bottom: 60px; }
